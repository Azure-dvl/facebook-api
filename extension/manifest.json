{
  "manifest_version": 2,
  "name": "Facebook API - Exportador de sesión",
  "version": "1.0.0",
  "description": "Exporta las cookies de tu sesión de Facebook (Firefox) a la API para automatizar publicaciones.",
  "permissions": ["cookies", "storage", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Facebook API - Exportar sesión",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "facebook-api-export@local",
      "strict_min_version": "102.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  }
}