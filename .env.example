APP_NAME=Facebook API
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=fb_user
DB_PASSWORD=changeme
DB_NAME=facebook_api
# Supabase y otros Postgres gestionados exigen SSL. En local: false.
DB_SSL=false

ENCRYPTION_KEY=generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"


# Solo llenar si la API esta hosteada en un servidor remoto: la URL con la que
# se accede desde afuera (la que va en el QR y los links).
# Ej: APP_PUBLIC_URL=https://api.midominio.com
# Si esta vacia se usa http://localhost:PORT
APP_PUBLIC_URL=

